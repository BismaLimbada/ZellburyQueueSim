@page "/simulator"
@inject ZellburyDataService DataService
@inject RandomGenerator Rng
@inject IJSRuntime JS

<PageTitle>Simulator · Zellbury Queue Simulation</PageTitle>

<header class="page-head">
    <h1>Simulator</h1>
    <p>Single-server checkout queue: Customers &rarr; Waiting Queue &rarr; Cashier &rarr; Exit. One cashier serves one customer at a time.</p>
</header>

<section class="panel">
    <h2>Simulation Setup</h2>
    <div class="field-groups">
        <div class="field-group">
            <span class="group-label">Counter</span>
            <label class="field"><span>Selected counter</span>
                <select @bind="selectedCounter" @bind:after="OnCounterChanged">
                    <option value="@CounterType.FemaleCounter">Female Counter (Women's Section)</option>
                    <option value="@CounterType.MaleCounter">Male Counter (Men's Section)</option>
                </select>
            </label>
            <p class="hint">Men's and women's data are never combined — each run uses only the selected counter's recorded observations.</p>
        </div>

        <div class="field-group">
            <span class="group-label">Queueing model</span>
            <label class="field"><span>Selected model</span>
                <select @bind="selectedModel">
                    <option value="@QueueingModel.MM1">M/M/1 — exponential arrivals &amp; service</option>
                    <option value="@QueueingModel.MG1">M/G/1 — exponential arrivals, empirical service</option>
                    <option value="@QueueingModel.GG1">G/G/1 — empirical arrivals &amp; service</option>
                </select>
            </label>
            <p class="hint">See <a href="/queueing/single-server/mm1">Queueing Models</a> for what each model assumes.</p>
        </div>

        <div class="field-group">
            <span class="group-label">Data source</span>
            <label class="field"><span>How customers are generated</span>
                <select @bind="dataSource">
                    <option value="@DataSourceMode.Recorded">Recorded data (trace-driven replay)</option>
                    <option value="@DataSourceMode.Random">Random generation (Monte Carlo, model-based)</option>
                </select>
            </label>
            @if (dataSource == DataSourceMode.Recorded)
            {
                <p class="hint">Replays the exact @recorded.Count recorded arrival/service times for this counter — no randomness.</p>
            }
            else
            {
                <p class="hint">Generates new customers from the selected model, parameterized from this counter's recorded data.</p>
            }
        </div>

        @if (dataSource == DataSourceMode.Random)
        {
            <div class="field-group">
                <span class="group-label">Simulation run</span>
                <label class="field"><span>Customers to simulate</span>
                    <input type="number" step="1" min="1" max="5000" @bind="numberOfCustomers" /></label>
                <label class="field"><span>Random seed <em>(reproducible)</em></span>
                    <input type="number" step="1" @bind="seed" /></label>
            </div>
        }
    </div>

    <div class="rho-line">
        <span>&lambda; = @Lambda.ToString("0.00")/min &nbsp;&middot;&nbsp; &mu; = @Mu.ToString("0.00")/min &nbsp;&middot;&nbsp; &rho; = &lambda;/&mu; = <strong>@Rho.ToString("0.000")</strong></span>
        @if (Rho >= 1) { <span class="tag tag-bad">Unstable</span> } else { <span class="tag tag-good">Stable</span> }
    </div>

    <div class="btn-row">
        <button class="btn-run" @onclick="RunSimulation" disabled="@isRunning">@(isRunning ? "Running…" : "▶ Run Simulation")</button>
        <button class="btn-reset" @onclick="ResetSimulation">&#8635; Reset</button>
    </div>
    @if (errorMessage is not null) { <p class="error-text">@errorMessage</p> }
</section>

<section class="panel">
    <h2>Single-Server Queue Visualization</h2>
    <p class="hint">Only one cashier serves one customer at a time — everyone else waits in a single FIFO line.</p>
    <div class="queue-viz">
        <div class="queue-viz-zone">
            <span class="queue-viz-caption">Waiting Queue</span>
            <div class="queue-customers">
                @if (DisplayWaitingCount == 0)
                {
                    <span class="queue-empty-note">No customers waiting</span>
                }
                else
                {
                    @for (int i = 0; i < DisplayWaitingCount; i++)
                    {
                        <div class="cust-icon">🧍</div>
                    }
                    @if (OverflowCount > 0)
                    {
                        <div class="cust-icon overflow">+@OverflowCount</div>
                    }
                }
            </div>
        </div>
        <div class="queue-arrow">&rarr;</div>
        <div class="cashier-box @(CashierBusyClass)">
            <div class="cashier-icon">🧾</div>
            <div class="cashier-label">CASHIER</div>
            <div class="cashier-state">@CashierStateText</div>
        </div>
        <div class="queue-arrow">&rarr;</div>
        <div class="exit-box">EXIT</div>
    </div>
    <p class="hint" style="margin-top:10px;">@QueueVizCaption</p>
</section>

<section class="panel">
    <h2>Real-World Data (Ground Truth) — @DataService.GetCounterLabel(selectedCounter)</h2>
    <p class="hint">Aggregates computed directly from the field-recorded timestamps, no queueing-model assumptions applied.</p>
    <div class="ticker" style="margin-top:12px; box-shadow:none;">
        <div class="ticker-item"><span class="ticker-value">@recorded.Count</span><span class="ticker-label">Customers Observed</span></div>
        <div class="ticker-item"><span class="ticker-value">@AvgInterArrival.ToString("0.00")<small>min</small></span><span class="ticker-label">Avg Inter-Arrival</span></div>
        <div class="ticker-item"><span class="ticker-value">@AvgWait.ToString("0.00")<small>min</small></span><span class="ticker-label">Avg Waiting Time</span></div>
        <div class="ticker-item"><span class="ticker-value">@AvgService.ToString("0.00")<small>min</small></span><span class="ticker-label">Avg Service Time</span></div>
        <div class="ticker-item"><span class="ticker-value">@AvgTis.ToString("0.00")<small>min</small></span><span class="ticker-label">Avg Time in System</span></div>
    </div>

    <div class="table-scroll" style="margin-top:16px;">
        <table class="table">
            <thead><tr><th>ID</th><th>Inter-Arrival</th><th>Arrival</th><th>Service Start</th><th>Service Time</th><th>Service End</th><th>Waiting</th><th>Time in System</th></tr></thead>
            <tbody>
                @foreach (var c in recorded)
                {
                    <tr>
                        <td>@c.Id</td><td>@c.InterArrivalTime.ToString("0.0")</td><td>@c.ArrivalTime.ToString("0.0")</td>
                        <td>@c.ServiceStartTime.ToString("0.0")</td><td>@c.ServiceTime.ToString("0.0")</td>
                        <td>@c.ServiceEndTime.ToString("0.0")</td><td>@c.WaitingTime.ToString("0.0")</td><td>@c.TimeInSystem.ToString("0.0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="panel">
    <h2>Timeline — Waiting vs Service, per Customer (Recorded Data)</h2>
    <p class="hint">Each row is one customer: the muted segment is time spent waiting, the accent segment is time being served.</p>
    <canvas id="simulatorGantt" height="@(Math.Max(recorded.Count * 20, 200))"></canvas>
</section>

@if (result is not null && theoretical is not null)
{
    <section class="ticker">
        <div class="ticker-item"><span class="ticker-value">@ModelLabel</span><span class="ticker-label">Model Simulated</span></div>
        <div class="ticker-item"><span class="ticker-value">@DataService.GetCounterLabel(selectedCounter)</span><span class="ticker-label">Counter</span></div>
        <div class="ticker-item"><span class="ticker-value">@result.CustomersServed</span><span class="ticker-label">Customers Served</span></div>
        <div class="ticker-item"><span class="ticker-value">@result.AverageWaitingTime.ToString("0.00")<small>min</small></span><span class="ticker-label">Avg Waiting Time</span></div>
        <div class="ticker-item"><span class="ticker-value">@result.AverageServiceTime.ToString("0.00")<small>min</small></span><span class="ticker-label">Avg Service Time</span></div>
        <div class="ticker-item"><span class="ticker-value">@result.AverageQueueLength.ToString("0.00")</span><span class="ticker-label">Avg Queue Length</span></div>
        <div class="ticker-item"><span class="ticker-value">@((result.ServerUtilization * 100).ToString("0.0"))<small>%</small></span><span class="ticker-label">Utilization</span></div>
        <div class="ticker-item"><span class="ticker-value">@result.AverageTimeInSystem.ToString("0.00")<small>min</small></span><span class="ticker-label">Avg Time in System</span></div>
    </section>

    <section class="panel">
        <h2>Theoretical (@ModelLabel) vs Simulated</h2>
        @if (!theoretical.IsStable) { <p class="tag tag-bad" style="margin-bottom:10px;">System unstable at these parameters — steady-state theoretical values undefined.</p> }
        <table class="table">
            <thead><tr><th>Metric</th><th>Theoretical</th><th>Simulated</th><th>Diff</th></tr></thead>
            <tbody>
                <tr><td>Wq — avg waiting time</td><td>@(theoretical.IsStable ? theoretical.Wq.ToString("0.00") : "N/A")</td><td>@result.AverageWaitingTime.ToString("0.00")</td><td>@DiffText(theoretical.Wq, result.AverageWaitingTime, theoretical.IsStable)</td></tr>
                <tr><td>W — avg time in system</td><td>@(theoretical.IsStable ? theoretical.W.ToString("0.00") : "N/A")</td><td>@result.AverageTimeInSystem.ToString("0.00")</td><td>@DiffText(theoretical.W, result.AverageTimeInSystem, theoretical.IsStable)</td></tr>
                <tr><td>Lq — avg queue length</td><td>@(theoretical.IsStable ? theoretical.Lq.ToString("0.00") : "N/A")</td><td>@result.AverageQueueLength.ToString("0.00")</td><td>@DiffText(theoretical.Lq, result.AverageQueueLength, theoretical.IsStable)</td></tr>
                <tr><td>L — avg number in system</td><td>@(theoretical.IsStable ? theoretical.L.ToString("0.00") : "N/A")</td><td>@result.AverageNumberInSystem.ToString("0.00")</td><td>@DiffText(theoretical.L, result.AverageNumberInSystem, theoretical.IsStable)</td></tr>
                <tr><td>&rho; — utilization</td><td>@theoretical.Rho.ToString("0.000")</td><td>@result.ServerUtilization.ToString("0.000")</td><td>@DiffText(theoretical.Rho, result.ServerUtilization, true)</td></tr>
            </tbody>
        </table>
        <p class="hint">Theoretical values come from the closed-form/approximate steady-state formulas for @ModelLabel; "Simulated" is the actual discrete-event run above.</p>
    </section>

    <div class="split">
        <section class="panel"><h3>Queue Length Over Time</h3><canvas id="simulatorQueueChart" height="220"></canvas></section>
        <section class="panel"><h3>Waiting Time per Customer vs Theoretical Wq</h3><canvas id="simulatorWaitChart" height="220"></canvas></section>
    </div>

    <section class="panel">
        <h2>Customer-Level Detail (@result.Customers.Count records)</h2>
        <div class="table-scroll">
            <table class="table">
                <thead><tr><th>Customer</th><th>Arrival Time</th><th>Service Start Time</th><th>Service End Time</th><th>Waiting Time</th><th>Service Time</th><th>Time in System</th></tr></thead>
                <tbody>
                    @foreach (var c in result.Customers)
                    {
                        <tr>
                            <td>@c.Id</td><td>@c.ArrivalTime.ToString("0.00")</td>
                            <td>@(c.IsCompleted ? c.ServiceStartTime.ToString("0.00") : "—")</td>
                            <td>@(c.IsCompleted ? c.ServiceEndTime.ToString("0.00") : "—")</td>
                            <td>@(c.IsCompleted ? c.WaitingTime.ToString("0.00") : "—")</td>
                            <td>@(c.IsCompleted ? c.ServiceTime.ToString("0.00") : "—")</td>
                            <td>@(c.IsCompleted ? c.TimeInSystem.ToString("0.00") : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
else
{
    <div class="panel empty-state">
        <p>No simulation has been run yet. Configure the settings above and click <strong>Run Simulation</strong>.</p>
    </div>
}

@code {
    private enum QueueingModel { MM1, MG1, GG1 }
    private enum DataSourceMode { Recorded, Random }

    private CounterType selectedCounter = CounterType.FemaleCounter;
    private QueueingModel selectedModel = QueueingModel.MM1;
    private DataSourceMode dataSource = DataSourceMode.Recorded;

    private List<Customer> recorded = new();
    private SimulationResult? result;
    private TheoreticalResult? theoretical;

    private int numberOfCustomers = 200;
    private long seed = 42;
    private bool isRunning;
    private string? errorMessage;
    private bool ganttPending = true;
    private bool resultChartsPending;

    private double AvgInterArrival => recorded.Count > 1 ? recorded.Skip(1).Average(c => c.InterArrivalTime) : 0;
    private double AvgWait => recorded.Count > 0 ? recorded.Average(c => c.WaitingTime) : 0;
    private double AvgService => recorded.Count > 0 ? recorded.Average(c => c.ServiceTime) : 0;
    private double AvgTis => recorded.Count > 0 ? recorded.Average(c => c.TimeInSystem) : 0;

    private double Lambda => DataService.GetMeanInterArrivalTime(selectedCounter) > 0 ? 1.0 / DataService.GetMeanInterArrivalTime(selectedCounter) : 0;
    private double Mu => DataService.GetMeanServiceTime(selectedCounter) > 0 ? 1.0 / DataService.GetMeanServiceTime(selectedCounter) : 0;
    private double Rho => Mu > 0 ? Lambda / Mu : 0;

    private string ModelLabel => selectedModel switch
    {
        QueueingModel.MM1 => "M/M/1",
        QueueingModel.MG1 => "M/G/1",
        _ => "G/G/1"
    };

    // ---- Queue visualization (reflects the last run, or a resting/idle state before any run) ----
    private int DisplayWaitingCount => result is null ? 0 : Math.Min((int)Math.Round(result.AverageQueueLength), 6);
    private int OverflowCount => result is null ? 0 : Math.Max(0, (int)Math.Round(result.AverageQueueLength) - 6);
    private string CashierBusyClass => result is not null && result.ServerUtilization > 0 ? "busy" : "idle";
    private string CashierStateText => result is null
        ? "Idle"
        : $"Busy {(result.ServerUtilization * 100):0.0}% of the time";
    private string QueueVizCaption => result is null
        ? "Run a simulation to see the average queue length and cashier utilization reflected here."
        : $"Snapshot reflects the average queue length ({result.AverageQueueLength:0.00} customers) and utilization from the last run.";

    protected override void OnInitialized() => LoadRecorded();

    private void OnCounterChanged()
    {
        LoadRecorded();
        result = null;
        theoretical = null;
    }

    private void LoadRecorded()
    {
        recorded = DataService.GetRecordedCustomers(selectedCounter);
        ganttPending = true;
    }

    private void RunSimulation()
    {
        errorMessage = null;

        if (dataSource == DataSourceMode.Recorded)
        {
            if (recorded.Count == 0) { errorMessage = "No recorded data available for this counter."; return; }

            var interArrivals = new Queue<double>(recorded.Select(c => c.InterArrivalTime));
            var serviceTimes = new Queue<double>(recorded.Select(c => c.ServiceTime));

            var engine = new SimulationEngine(
                nextInterArrivalTime: () => interArrivals.Dequeue(),
                nextServiceTime: () => serviceTimes.Dequeue(),
                numberOfCustomersToGenerate: recorded.Count,
                seed: 0);

            result = engine.Run();
        }
        else
        {
            if (numberOfCustomers <= 0) { errorMessage = "Number of customers must be at least 1."; return; }

            isRunning = true;
            Rng.Reseed(seed);

            double lambda = Lambda;
            double mu = Mu;
            var sortedService = DataService.GetSortedServiceTimes(selectedCounter);
            var sortedInterArrival = DataService.GetSortedInterArrivalTimes(selectedCounter);

            Func<double> nextArrival;
            Func<double> nextService;

            switch (selectedModel)
            {
                case QueueingModel.MM1:
                    nextArrival = () => Rng.NextPoissonInterArrival(lambda);
                    nextService = () => Rng.NextExponential(mu);
                    break;
                case QueueingModel.MG1:
                    nextArrival = () => Rng.NextPoissonInterArrival(lambda);
                    nextService = () => Rng.NextEmpirical(sortedService);
                    break;
                default: // GG1
                    nextArrival = () => Rng.NextEmpirical(sortedInterArrival);
                    nextService = () => Rng.NextEmpirical(sortedService);
                    break;
            }

            var engine = new SimulationEngine(nextArrival, nextService, numberOfCustomers, seed);
            result = engine.Run();
            isRunning = false;
        }

        theoretical = ComputeTheoretical();
        resultChartsPending = true;
    }

    private TheoreticalResult ComputeTheoretical()
    {
        double lambda = Lambda;
        double mu = Mu;

        return selectedModel switch
        {
            QueueingModel.MM1 => MM1Model.Compute(lambda, mu),
            QueueingModel.MG1 => MG1Model.Compute(lambda, DataService.GetMeanServiceTime(selectedCounter), DataService.GetServiceTimeVariance(selectedCounter)),
            _ => GG1Model.Compute(lambda, mu, DataService.GetCaSquared(selectedCounter), DataService.GetCsSquared(selectedCounter))
        };
    }

    private void ResetSimulation()
    {
        result = null;
        theoretical = null;
        errorMessage = null;
        isRunning = false;
        selectedCounter = CounterType.FemaleCounter;
        selectedModel = QueueingModel.MM1;
        dataSource = DataSourceMode.Recorded;
        numberOfCustomers = 200;
        seed = 42;
        LoadRecorded();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ganttPending)
        {
            ganttPending = false;
            await RenderGantt();
        }

        if (resultChartsPending && result is not null && theoretical is not null)
        {
            resultChartsPending = false;

            var labels = result.QueueLengthTrace.Select(q => q.Time.ToString("0.0")).ToArray();
            var values = result.QueueLengthTrace.Select(q => (double)q.QueueLength).ToArray();
            await JS.InvokeVoidAsync("zellburyCharts.renderLineChart", "simulatorQueueChart", labels,
                new[] { new { label = "Queue length", data = values, color = "#3f6b5e", dashed = false } },
                "Customers waiting", "Simulation time (min)", true);

            var custIds = result.Customers.Where(c => c.IsCompleted).Select(c => c.Id.ToString()).ToArray();
            var waits = result.Customers.Where(c => c.IsCompleted).Select(c => c.WaitingTime).ToArray();
            double referenceWq = theoretical.IsStable ? theoretical.Wq : 0;
            await JS.InvokeVoidAsync("zellburyCharts.renderScatterWithReference", "simulatorWaitChart", custIds, waits,
                referenceWq, "Simulated wait", $"Theoretical Wq ({ModelLabel})", "Waiting time (min)", "Customer");
        }
    }

    private async Task RenderGantt()
    {
        if (recorded.Count == 0) return;
        var labels = recorded.Select(c => $"#{c.Id}").ToArray();
        var waitSegments = recorded.Select(c => new[] { c.ArrivalTime, c.ServiceStartTime }).ToArray();
        var serviceSegments = recorded.Select(c => new[] { c.ServiceStartTime, c.ServiceEndTime }).ToArray();
        await JS.InvokeVoidAsync("zellburyCharts.renderGanttChart", "simulatorGantt", labels, waitSegments, serviceSegments);
    }

    private static string DiffText(double t, double s, bool stable)
    {
        if (!stable) return "—";
        double diff = s - t;
        return (diff >= 0 ? "+" : "") + diff.ToString("0.00");
    }
}
