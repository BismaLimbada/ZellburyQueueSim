@page "/queueing/single-server/mg1"

<PageTitle>M/G/1 · Zellbury Queue Simulation</PageTitle>

<header class="page-head">
    <h1>Queueing Models — Single Server</h1>
    <p>Theory and a calculator driven by your own inputs. To compare the formulas with the recorded Zellbury data, use the <a href="/simulator">Simulator</a>.</p>
</header>

<ModelTabs />

<section class="panel">
    <h2>M/G/1 — Poisson Arrivals, General Service</h2>
    <p>
        Same Poisson arrivals (rate &lambda;), one cashier and FIFO service as M/M/1, but service time may follow
        <strong>any</strong> distribution, described only by its mean E[S] = 1/&mu; and variance &sigma;<sub>s</sub>&sup2;.
        This captures the real spread of transaction times, from a quick exchange to a large multi-item purchase.
    </p>
    <div class="note-strip">
        Results come from the <strong>Pollaczek&ndash;Khinchine formula</strong> and need <strong>&rho; = &lambda;&middot;E[S] &lt; 1</strong>.
        Setting &sigma;<sub>s</sub>&sup2; = 1/&mu;&sup2; (an exponential) recovers M/M/1 exactly.
    </div>
    <table class="table">
        <thead><tr><th>Quantity</th><th>Formula</th><th>Meaning</th></tr></thead>
        <tbody>
            <tr><td>&rho;</td><td>&lambda;&middot;E[S]</td><td>Server utilization</td></tr>
            <tr><td>Lq</td><td>(&lambda;&sup2;&sigma;<sub>s</sub>&sup2; + &rho;&sup2;) / (2(1&minus;&rho;))</td><td>Avg number waiting (P-K formula)</td></tr>
            <tr><td>Wq</td><td>Lq/&lambda;</td><td>Avg waiting time</td></tr>
            <tr><td>W</td><td>Wq + 1/&mu;</td><td>Avg time in the system</td></tr>
            <tr><td>L</td><td>&lambda;&middot;W</td><td>Avg number in system (Little's Law)</td></tr>
            <tr><td>P<sub>0</sub> (idle time)</td><td>1 &minus; &rho;</td><td>Probability the system is empty = fraction of time the server is idle</td></tr>
        </tbody>
    </table>
</section>

<section class="panel">
    <h2>M/G/1 Calculator</h2>
    <p class="hint calc-hint">Enter the arrival rate, the service rate and the service-time variance. Results update as you type.</p>
    <div class="field-groups">
        <div class="field-group field-row">
            <span class="group-label">Inputs</span>
            <label class="field"><span>&lambda; — arrival rate <em>(customers/min)</em></span>
                <input type="number" step="0.01" min="0" @bind="lambda" @bind:event="oninput" /></label>
            <label class="field"><span>&mu; — service rate = 1 / E[S] <em>(customers/min)</em></span>
                <input type="number" step="0.01" min="0" @bind="mu" @bind:event="oninput" /></label>
            <label class="field"><span>&sigma;<sub>s</sub>&sup2; — service-time variance <em>(min&sup2;)</em></span>
                <input type="number" step="0.01" min="0" @bind="serviceVariance" @bind:event="oninput" /></label>
        </div>
    </div>
    <div class="rho-line">
        <span>&rho; = &lambda;/&mu; = <strong>@Rho.ToString("0.000")</strong></span>
        @if (!InputsValid) { <span class="tag tag-bad">Invalid input</span> }
        else if (Rho >= 1) { <span class="tag tag-bad">Unstable (&rho; &ge; 1)</span> }
        else { <span class="tag tag-good">Stable (&rho; &lt; 1)</span> }
    </div>
    <TheoryResultTable Result="Result" InputsValid="InputsValid" InvalidMessage="@InvalidMessage" />
</section>

@code {
    private double lambda = 0.5;
    private double mu = 0.6;
    private double serviceVariance = 2.0;

    private bool InputsValid => lambda > 0 && mu > 0 && serviceVariance >= 0;
    private double Rho => mu > 0 ? lambda / mu : 0;
    private string InvalidMessage => "Enter \u03BB > 0, \u03BC > 0 and a service-time variance of 0 or more.";
    private TheoreticalResult? Result => InputsValid ? MG1Model.Compute(lambda, 1.0 / mu, serviceVariance) : null;
}
