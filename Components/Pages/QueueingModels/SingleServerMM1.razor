@page "/queueing/single-server/mm1"
@rendermode InteractiveServer
@inject RandomGenerator Rng
@inject ZellburyDataService DataService
@inject IJSRuntime JS

<PageTitle>M/M/1 · Zellbury Queue Simulation</PageTitle>

<div class="page-header">
    <h1>M/M/1 — Single Server</h1>
    <p>Poisson arrivals · Exponential service · One counter · FIFO/FCFS</p>
</div>

<div class="section-note">
    Default λ and μ below are estimated from the recorded Female Counter data
    (mean inter-arrival ≈ @DataService.GetMeanInterArrivalTime(CounterType.FemaleCounter).ToString("0.00") min,
    mean service ≈ @DataService.GetMeanServiceTime(CounterType.FemaleCounter).ToString("0.00") min during the
    observed 16:20–17:20 window). That window shows heavier arrivals than the counter could clear
    (ρ &gt; 1), so try lowering λ or raising μ below to explore a stable configuration.
</div>

<div class="card">
    <h2>Configuration</h2>
    <div class="grid-3">
        <div class="form-row">
            <label>Arrival rate λ (customers / min)</label>
            <input type="number" step="0.01" min="0.01" @bind="lambda" />
            <span class="hint">Poisson arrival process rate</span>
        </div>
        <div class="form-row">
            <label>Service rate μ (customers / min)</label>
            <input type="number" step="0.01" min="0.01" @bind="mu" />
            <span class="hint">Exponential service rate</span>
        </div>
        <div class="form-row">
            <label>Customers to simulate</label>
            <input type="number" step="1" min="1" max="5000" @bind="numberOfCustomers" />
        </div>
        <div class="form-row">
            <label>Random seed</label>
            <input type="number" step="1" @bind="seed" />
            <span class="hint">Same seed ⇒ identical run, every time</span>
        </div>
        <div class="form-row">
            <label>ρ = λ / μ</label>
            <span class="stat-value" style="font-size:1.1rem">@Rho.ToString("0.000")</span>
            @if (Rho >= 1)
            {
                <span class="badge badge-unstable">Unstable (ρ ≥ 1)</span>
            }
            else
            {
                <span class="badge badge-stable">Stable</span>
            }
        </div>
    </div>
    <button class="btn btn-primary" @onclick="RunSimulation" disabled="@isRunning">
        @(isRunning ? "Running…" : "▶ Run Simulation")
    </button>
    @if (errorMessage is not null)
    {
        <p style="color:var(--red); margin-top:10px;">@errorMessage</p>
    }
</div>

@if (result is not null && theoretical is not null)
{
    <div class="card">
        <h2>Results Dashboard</h2>
        <div class="grid-3">
            <div class="stat-tile"><div class="stat-label">Customers Served</div><div class="stat-value">@result.CustomersServed</div></div>
            <div class="stat-tile"><div class="stat-label">Customers Remaining</div><div class="stat-value">@result.CustomersRemaining</div></div>
            <div class="stat-tile"><div class="stat-label">Simulation Clock</div><div class="stat-value">@result.SimulationEndTime.ToString("0.0")<span class="stat-sub"> min</span></div></div>

            <div class="stat-tile"><div class="stat-label">Avg Inter-Arrival Time</div><div class="stat-value">@result.AverageInterArrivalTime.ToString("0.00")<span class="stat-sub"> min</span></div></div>
            <div class="stat-tile"><div class="stat-label">Avg Waiting Time (Wq)</div><div class="stat-value">@result.AverageWaitingTime.ToString("0.00")<span class="stat-sub"> min</span></div></div>
            <div class="stat-tile"><div class="stat-label">Avg Service Time</div><div class="stat-value">@result.AverageServiceTime.ToString("0.00")<span class="stat-sub"> min</span></div></div>

            <div class="stat-tile"><div class="stat-label">Avg Time in System (W)</div><div class="stat-value">@result.AverageTimeInSystem.ToString("0.00")<span class="stat-sub"> min</span></div></div>
            <div class="stat-tile"><div class="stat-label">Avg Queue Length (Lq)</div><div class="stat-value">@result.AverageQueueLength.ToString("0.00")</div></div>
            <div class="stat-tile"><div class="stat-label">Max Queue Length</div><div class="stat-value">@result.MaximumQueueLength</div></div>

            <div class="stat-tile"><div class="stat-label">Server Utilization</div><div class="stat-value">@((result.ServerUtilization * 100).ToString("0.0"))<span class="stat-sub">%</span></div></div>
            <div class="stat-tile"><div class="stat-label">Avg Number in System (L)</div><div class="stat-value">@result.AverageNumberInSystem.ToString("0.00")</div></div>
            <div class="stat-tile"><div class="stat-label">Little's Law: λ·W</div><div class="stat-value">@result.LittlesLawL.ToString("0.00")</div></div>
        </div>
    </div>

    <div class="card">
        <h2>Theoretical vs Simulated</h2>
        @if (!theoretical.IsStable)
        {
            <p class="badge badge-unstable" style="margin-bottom:10px;">System is unstable at these inputs (ρ ≥ 1) — steady-state theoretical values are undefined. Only simulated (transient) results are meaningful below.</p>
        }
        <table class="data-table compare-table">
            <thead><tr><th>Metric</th><th>Theoretical (M/M/1)</th><th>Simulated</th><th>Difference</th></tr></thead>
            <tbody>
                <tr>
                    <td>Wq — avg waiting time</td>
                    <td>@(theoretical.IsStable ? theoretical.Wq.ToString("0.00") : "N/A")</td>
                    <td>@result.AverageWaitingTime.ToString("0.00")</td>
                    <td class="@DiffClass(theoretical.Wq, result.AverageWaitingTime, theoretical.IsStable)">@DiffText(theoretical.Wq, result.AverageWaitingTime, theoretical.IsStable)</td>
                </tr>
                <tr>
                    <td>W — avg time in system</td>
                    <td>@(theoretical.IsStable ? theoretical.W.ToString("0.00") : "N/A")</td>
                    <td>@result.AverageTimeInSystem.ToString("0.00")</td>
                    <td class="@DiffClass(theoretical.W, result.AverageTimeInSystem, theoretical.IsStable)">@DiffText(theoretical.W, result.AverageTimeInSystem, theoretical.IsStable)</td>
                </tr>
                <tr>
                    <td>Lq — avg queue length</td>
                    <td>@(theoretical.IsStable ? theoretical.Lq.ToString("0.00") : "N/A")</td>
                    <td>@result.AverageQueueLength.ToString("0.00")</td>
                    <td class="@DiffClass(theoretical.Lq, result.AverageQueueLength, theoretical.IsStable)">@DiffText(theoretical.Lq, result.AverageQueueLength, theoretical.IsStable)</td>
                </tr>
                <tr>
                    <td>L — avg number in system</td>
                    <td>@(theoretical.IsStable ? theoretical.L.ToString("0.00") : "N/A")</td>
                    <td>@result.AverageNumberInSystem.ToString("0.00")</td>
                    <td class="@DiffClass(theoretical.L, result.AverageNumberInSystem, theoretical.IsStable)">@DiffText(theoretical.L, result.AverageNumberInSystem, theoretical.IsStable)</td>
                </tr>
                <tr>
                    <td>Utilization (ρ)</td>
                    <td>@theoretical.Rho.ToString("0.000")</td>
                    <td>@result.ServerUtilization.ToString("0.000")</td>
                    <td class="@DiffClass(theoretical.Rho, result.ServerUtilization, true)">@DiffText(theoretical.Rho, result.ServerUtilization, true)</td>
                </tr>
                <tr>
                    <td>P0 — probability system empty</td>
                    <td>@(theoretical.IsStable ? theoretical.P0!.Value.ToString("0.000") : "N/A")</td>
                    <td>@((1 - result.ServerUtilization).ToString("0.000"))<span class="hint"> (1 − utilization, empirical)</span></td>
                    <td>—</td>
                </tr>
            </tbody>
        </table>
        <p class="hint" style="margin-top:8px;">Differences shrink as "Customers to simulate" grows — this is the law of large numbers converging the simulation toward the steady-state theoretical values.</p>
    </div>

    <div class="grid-2">
        <div class="card">
            <h3>Queue Length Over Time</h3>
            <canvas id="mm1QueueChart" height="220"></canvas>
        </div>
        <div class="card">
            <h3>Theoretical vs Simulated (key metrics)</h3>
            <canvas id="mm1CompareChart" height="220"></canvas>
        </div>
    </div>

    <div class="card">
        <h2>Customer-Level Detail (@result.Customers.Count records)</h2>
        <div class="table-scroll">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th><th>Inter-Arrival</th><th>Arrival</th><th>Service Start</th>
                        <th>Service Time</th><th>Service End</th><th>Waiting</th><th>Time in System</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in result.Customers)
                    {
                        <tr>
                            <td>@c.Id</td>
                            <td>@c.InterArrivalTime.ToString("0.00")</td>
                            <td>@c.ArrivalTime.ToString("0.00")</td>
                            <td>@(c.IsCompleted ? c.ServiceStartTime.ToString("0.00") : "—")</td>
                            <td>@(c.IsCompleted ? c.ServiceTime.ToString("0.00") : "—")</td>
                            <td>@(c.IsCompleted ? c.ServiceEndTime.ToString("0.00") : "—")</td>
                            <td>@(c.IsCompleted ? c.WaitingTime.ToString("0.00") : "—")</td>
                            <td>@(c.IsCompleted ? c.TimeInSystem.ToString("0.00") : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private double lambda;
    private double mu;
    private int numberOfCustomers = 200;
    private long seed = 42;
    private bool isRunning;
    private bool chartsPending;
    private string? errorMessage;

    private SimulationResult? result;
    private TheoreticalResult? theoretical;

    private double Rho => mu > 0 ? lambda / mu : 0;

    protected override void OnInitialized()
    {
        lambda = Math.Round(1.0 / DataService.GetMeanInterArrivalTime(CounterType.FemaleCounter), 2);
        mu = Math.Round(1.0 / DataService.GetMeanServiceTime(CounterType.FemaleCounter), 2);
    }

    private void RunSimulation()
    {
        errorMessage = null;

        if (lambda <= 0 || mu <= 0)
        {
            errorMessage = "λ and μ must both be positive numbers.";
            return;
        }
        if (numberOfCustomers <= 0)
        {
            errorMessage = "Number of customers must be at least 1.";
            return;
        }

        isRunning = true;
        Rng.Reseed(seed);

        var engine = new SimulationEngine(
            nextInterArrivalTime: () => Rng.NextPoissonInterArrival(lambda),
            nextServiceTime: () => Rng.NextExponential(mu),
            numberOfCustomersToGenerate: numberOfCustomers,
            seed: seed);

        result = engine.Run();
        theoretical = MM1Model.Compute(lambda, mu);
        isRunning = false;
        chartsPending = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chartsPending && result is not null && theoretical is not null)
        {
            chartsPending = false;

            var labels = result.QueueLengthTrace.Select(q => q.Time.ToString("0.0")).ToArray();
            var values = result.QueueLengthTrace.Select(q => (double)q.QueueLength).ToArray();
            await JS.InvokeVoidAsync("zellburyCharts.renderLineChart", "mm1QueueChart", labels,
                new[] { new { label = "Queue length", data = values, color = "#2f6fed" } },
                "Customers waiting", "Simulation time (min)", true);

            var metricLabels = new[] { "Wq", "W", "Lq", "L", "ρ" };
            var theo = new[] { theoretical.IsStable ? theoretical.Wq : 0, theoretical.IsStable ? theoretical.W : 0,
                                theoretical.IsStable ? theoretical.Lq : 0, theoretical.IsStable ? theoretical.L : 0, theoretical.Rho };
            var sim = new[] { result.AverageWaitingTime, result.AverageTimeInSystem, result.AverageQueueLength,
                               result.AverageNumberInSystem, result.ServerUtilization };
            await JS.InvokeVoidAsync("zellburyCharts.renderBarComparison", "mm1CompareChart", metricLabels, theo, sim, "Theoretical", "Simulated", "Value");
        }
    }

    private static string DiffText(double theoreticalValue, double simulatedValue, bool isStable)
    {
        if (!isStable) return "—";
        double diff = simulatedValue - theoreticalValue;
        return (diff >= 0 ? "+" : "") + diff.ToString("0.00");
    }

    private static string DiffClass(double theoreticalValue, double simulatedValue, bool isStable)
    {
        if (!isStable) return "";
        double relDiff = theoreticalValue == 0 ? 0 : Math.Abs(simulatedValue - theoreticalValue) / Math.Max(theoreticalValue, 0.0001);
        return relDiff < 0.15 ? "diff-ok" : "diff-warn";
    }
}
